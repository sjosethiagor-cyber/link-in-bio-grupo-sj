rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is the authorized administrator
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email != null &&
             request.auth.token.email_verified == true &&
             request.auth.token.email == "sjosethiago.r@gmail.com";
    }

    // Regras para a coleção de cliques (Analytics)
    match /clicks/{document} {
      // Qualquer visitante pode registrar um clique com dados válidos
      allow create: if request.resource.data.keys().hasAll(['linkId', 'linkName', 'category', 'timestamp']) &&
                       request.resource.data.keys().hasOnly(['id', 'linkId', 'linkName', 'category', 'timestamp', 'serverTime']) &&
                       request.resource.data.linkId is string && request.resource.data.linkId.size() <= 100 &&
                       request.resource.data.linkName is string && request.resource.data.linkName.size() <= 200 &&
                       request.resource.data.category in ['Mercado Livre', 'Shopee', 'Rede Social', 'Contato'] &&
                       request.resource.data.timestamp is number;
      // Apenas o administrador autorizado pode visualizar ou modificar o histórico
      allow read, update, delete: if isAdmin();
    }

    // Regras para a coleção de Leads (Formulário de Solicitação)
    match /leads/{document} {
      // Qualquer visitante pode enviar um novo lead com schema válido
      allow create: if request.resource.data.keys().hasAll(['name', 'whatsapp', 'createdAt', 'status']) &&
                       request.resource.data.keys().hasOnly(['id', 'name', 'whatsapp', 'email', 'message', 'createdAt', 'createdAtServer', 'status']) &&
                       request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 200 &&
                       request.resource.data.whatsapp is string && request.resource.data.whatsapp.size() >= 8 && request.resource.data.whatsapp.size() <= 60 &&
                       request.resource.data.status == 'Novo';
      // Apenas o administrador autorizado pode visualizar ou alterar o status do lead
      allow read, update, delete: if isAdmin();
    }

    // Regras para a coleção de Links do CMS
    match /links/{document} {
      // Todos os visitantes podem ler os links para navegar no site
      allow read: if true;
      // Apenas o administrador autorizado pode criar, editar ou apagar links
      allow write: if isAdmin();
    }
  }
}

// ═══════════════════════════════════════════════════════════════════════════════
// Firestore Rules para o projeto: central-de-anuncios-b62ca
// Database: anuncio
//
// ATENÇÃO: Cole estas regras no Console do Firebase:
// https://console.firebase.google.com/project/central-de-anuncios-b62ca/firestore/databases/anuncio/rules
// ═══════════════════════════════════════════════════════════════════════════════

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Coleção de Produtos (Catálogo da Central de Anúncios) ────────────────
    match /products/{productId} {
      allow read, write: if true;
    }

    // ── Coleção de Permissões de Usuário ──────────────────────────────────────
    match /user_roles/{email} {
      allow read, write: if true;
    }

    // ── Regra padrão para demais coleções ─────────────────────────────────────
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

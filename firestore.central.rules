// ═══════════════════════════════════════════════════════════════════════════════
// Firestore Rules para o projeto: central-de-anuncios-b62ca
// Database: anuncio
//
// ATENÇÃO: Estas regras devem ser coladas no Console do Firebase:
// https://console.firebase.google.com/project/central-de-anuncios-b62ca/firestore/databases/anuncio/rules
// ═══════════════════════════════════════════════════════════════════════════════

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Coleção de Produtos (Catálogo de Anúncios) ───────────────────────────
    match /products/{productId} {
      // Leitura pública/painel para exibir o catálogo de produtos
      allow read: if true;

      // Criação e atualização com validação de schema e tamanho
      allow create, update: if request.resource.data.keys().hasAll(['name', 'sku', 'updatedAt']) &&
                               request.resource.data.name is string &&
                               request.resource.data.name.size() >= 1 &&
                               request.resource.data.name.size() <= 500 &&
                               request.resource.data.sku is string &&
                               request.resource.data.sku.size() <= 100;

      // Exclusão permitida
      allow delete: if true;
    }

    // ── Coleção de Roles de Usuário ───────────────────────────────────────────
    match /user_roles/{email} {
      allow read, write: if true;
    }

    // ── Catch-all: negar acesso a qualquer outra coleção ──────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

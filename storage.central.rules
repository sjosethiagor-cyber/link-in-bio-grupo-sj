// ═══════════════════════════════════════════════════════════════════════════════
// Firebase Storage Rules para o projeto: central-de-anuncios-b62ca
//
// ATENÇÃO: Estas regras devem ser coladas no Console do Firebase:
// https://console.firebase.google.com/project/central-de-anuncios-b62ca/storage/rules
// ═══════════════════════════════════════════════════════════════════════════════

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Pasta de Imagens de Capa (Covers) ────────────────────────────────────
    match /covers/{fileName} {
      // Leitura permitida para exibição das imagens nos cards
      allow read: if true;

      // Upload permitido com limites de segurança (máximo 10 MB e apenas imagens)
      allow create: if request.auth != null && 
                       request.resource.size < 10 * 1024 * 1024 &&
                       request.resource.contentType.matches('image/.*');

      // Exclusão permitida apenas para autenticados
      allow delete: if request.auth != null;

      // Não permitir atualizar arquivos diretamente (deletar e recriar)
      allow update: if false;
    }

    // ── Catch-all: negar acesso a qualquer outro caminho ──────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
